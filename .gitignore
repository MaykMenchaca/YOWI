__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Node
node_modules/

# PHP portable descargado por iniciar-tienda.bat (no se versiona)
/php/

# OS
.DS_Store
Thumbs.db

# Claude Code cache
.claude/cache/
.claude/sessions/
.claude/paste-cache/
.claude/file-history/
.claude/shell-snapshots/
.claude/session-env/

# Archivos locales de impeccable
.impeccable/

# Backend PHP — credenciales reales de base de datos (nunca subir por git)
site/api/config/env.php

# Imágenes subidas desde el admin (se crean al subir), pero SIN ignorar el .htaccess de
# esas carpetas: es el guard que apaga la ejecución de PHP ahí. Sin esta excepción, un
# clon nuevo del repo reconstruye estas carpetas sin el guard.
site/assets/img/banners/*
!site/assets/img/banners/.htaccess
site/assets/img/brands/*
!site/assets/img/brands/.htaccess
site/assets/img/productos/*
!site/assets/img/productos/.htaccess
