# ─────────────────────────────────────────────────────────────────────────────
# .htaccess del docroot del storefront (site/).
# Recomendado: que public_html apunte AQUÍ. Aplica cabeceras de seguridad, fuerza
# HTTPS y desactiva el listado de directorios. Las subcarpetas api/ y
# assets/img/productos/ tienen reglas adicionales propias.
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Forzar HTTPS.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Bloquear archivos que no deben servirse (por si algún .md/.sql se colara aquí).
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|md|log|sh|bat|ini|example|dist)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^\.(?!well-known)">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # CSP ENFORCE para el storefront: script-src 'self' (sin inline ni CDN) → los
    # scripts inline se externalizaron. style-src conserva 'unsafe-inline' por los estilos
    # embebidos del maquetado (bajo riesgo). El panel admin usa su propia CSP en
    # site/admin/.htaccess (permite el CDN de Tailwind que carga ahí).
    # Nota: si algún día sirves la API en otro dominio, añade ese origen a connect-src.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
