# Carpeta de imágenes subidas por el admin. Defensa en profundidad:
# aunque upload-image.php valida MIME/extensión, aquí se desactiva por completo
# la ejecución de cualquier script, por si un archivo malicioso llegara a colarse.
php_flag engine off
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .pht
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|pht)$">
    Require all denied
</FilesMatch>
